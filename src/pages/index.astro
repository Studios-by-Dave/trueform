---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Flatwork and Foundations Co. | Trusted Concrete Contractor in Gastonia, NC | 20+ Years Experience"
  description="Flatwork and Foundations Co. (Quality Concrete Construction LLC of Gastonia) — trusted concrete contractor for 20+ years. Driveways, patios, sidewalks, retaining walls, paving & grading. Serving Gastonia, Belmont, Shelby & surrounding areas. Call (704) 674-8306."
>

<div class="legal-bar">Quality Concrete Construction LLC of Gastonia, NC &nbsp;—&nbsp; <strong>d/b/a Flatwork and Foundations Co.</strong> &nbsp;·&nbsp; Licensed & Insured</div>

<header>
  <div class="container nav">
    <a class="logo" href="#">
      <div class="logo-mark">FF</div>
      <div class="logo-type">
        <b>Flatwork</b>
        <span>and Foundations Co.</span>
      </div>
    </a>
    <nav>
      <ul>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#work">Our Work</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
    <div class="nav-cta">
      <a class="phone" href="tel:7046748306">(704) 674-8306</a>
      <a class="btn btn-dark" href="#contact">Get Estimate</a>
    </div>
  </div>
</header>

<!-- HERO -->
<section class="hero" style="padding:0">
  <div class="hero-left">
    <div class="hero-left-inner">
      <div class="eyebrow">Gastonia, NC · 20+ Years in Concrete</div>
      <h1>Built <em>Flat.</em><br />Poured to Last.</h1>
      <p>From Quality Concrete Construction LLC to <strong style="color:var(--stone-900);font-weight:600">Flatwork and Foundations Co.</strong> — same trusted crew, same precision. Premium flatwork, walls, and site prep that holds its line for decades.</p>
      <div class="hero-actions">
        <a class="btn btn-dark" href="tel:7046748306">Call (704) 674-8306</a>
        <a class="btn btn-light" href="#services">Explore Services →</a>
      </div>
      <div class="trust-row">
        <div class="trust-item"><b>20+</b><span>Years Experience</span></div>
        <div class="trust-item"><b>1,200+</b><span>Projects Poured</span></div>
        <div class="trust-item"><b>4.9★</b><span>Client Rated</span></div>
      </div>
    </div>
  </div>
  <div class="hero-right">
    <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?q=80&w=1600&auto=format&fit=crop" alt="Modern concrete driveway and home exterior in Gastonia NC by Flatwork and Foundations Co. - crisp broom finish" />
    <div class="hero-card">
      <div>
        <div class="stars">★★★★★</div>
        <b>Sarah L. — Gastonia, NC</b>
        <span>"Turned our ideas into reality with precision and care."</span>
      </div>
      <div style="font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)">Verified Review</div>
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" class="services">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow" style="justify-content:center">Comprehensive Concrete Solutions</div>
      <h2>Everything in concrete.<br />Nothing left unfinished.</h2>
      <p>Residential and commercial flatwork and site services across Greater Gastonia — built to spec, finished clean, and inspected twice.</p>
    </div>

    <div class="service-grid">
      <div class="service featured">
        <div class="service-icon">▭</div>
        <h3>Sidewalk & Walkway</h3>
        <p>ADA-aware, perfectly pitched sidewalks and custom walkways that tie your property together — safe, durable, beautiful.</p>
        <a href="#">View Details</a>
      </div>
      <div class="service">
        <div class="service-icon">◧</div>
        <h3>Retaining Walls</h3>
        <p>Engineered walls that hold grade and elevate design. Block, poured, and timber systems built to last.</p>
        <a href="#">View Details</a>
      </div>
      <div class="service">
        <div class="service-icon">⬔</div>
        <h3>Concrete Paving</h3>
        <p>Driveways, aprons and lots poured for strength. Proper base, rebar, and control joints — no shortcuts.</p>
        <a href="#">View Details</a>
      </div>
      <div class="service">
        <div class="service-icon">⬜</div>
        <h3>Patio Construction</h3>
        <p>Outdoor rooms in broomed, stamped, or exposed aggregate finishes. Designed for how you actually live.</p>
        <a href="#">View Details</a>
      </div>
      <div class="service">
        <div class="service-icon">⧉</div>
        <h3>Grading Services</h3>
        <p>Laser-level grading for drainage, foundations, and landscaping. Get the water right, everything else follows.</p>
        <a href="#">View Details</a>
      </div>
      <div class="service">
        <div class="service-icon">⬡</div>
        <h3>Land Clearing <span style="font-weight:400;text-transform:none;letter-spacing:0;color:var(--muted)">— Small Jobs</span></h3>
        <p>Brush, small lots, and site prep for new construction. Clean site, ready to build.</p>
        <a href="#">View Details</a>
      </div>
    </div>
    <p style="text-align:center;margin-top:16px;font-size:12px;color:var(--muted);letter-spacing:.06em">All services: <strong style="color:var(--stone-900)">Gastonia • Belmont • Stanley • Mount Holly • Shelby • Kings Mountain +</strong></p>
  </div>
</section>

<!-- PROOF / ABOUT -->
<section id="about" class="proof">
  <div class="container proof-grid">
    <div>
      <div class="eyebrow" style="color:var(--clay)">About Us</div>
      <h2>20 years of <em>straight lines</em> and solid ground.</h2>
      <p>We started as Quality Concrete Construction LLC. As <strong style="color:#fff">Flatwork and Foundations Co.</strong>, we're honoring that legacy with a name that says what we've always done: pour it flat, pour it right. Locally owned, Gastonia-rooted, and on site — not just on paper.</p>
      <div class="proof-list">
        <div class="proof-item">
          <div class="proof-icon">✓</div>
          <div><b>Precision & Craftsmanship</b><span>Thorough inspections, proper reinforcement, clean finishes every time.</span></div>
        </div>
        <div class="proof-item">
          <div class="proof-icon">◎</div>
          <div><b>Client-Centered</b><span>Clear bids, daily updates, and a site left cleaner than we found it.</span></div>
        </div>
        <div class="proof-item">
          <div class="proof-icon">◐</div>
          <div><b>Experienced Crew</b><span>Seasoned finishers who know the mix, the weather, and the timing.</span></div>
        </div>
        <div class="proof-item">
          <div class="proof-icon">⌖</div>
          <div><b>Locally Rooted</b><span>Born in Gaston County. We build for neighbors, not just customers.</span></div>
        </div>
      </div>
      <div style="margin-top:28px"><a class="btn btn-clay" href="#contact">Work With Our Team</a></div>
    </div>
    <div class="proof-image">
      <img src="https://irp.cdn-website.com/f924c162/dms3rep/multi/opt/New+Sidewalk+Installation+%287%29-484w.png" alt="Flatwork and Foundations Co. sidewalk installation detail" />
      <div class="badge">
        <b>20+</b>
        <span>Years<br />Serving<br />Gastonia</span>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIAL -->
<section>
  <div class="container quote-wrap">
    <div class="eyebrow" style="justify-content:center">Testimonials</div>
    <div class="stars" style="justify-content:center;display:flex">★★★★★</div>
    <blockquote class="quote">"The professionalism of the team at Flatwork and Foundations Co. is truly commendable. They turned our ideas into reality with precision and care. We highly recommend their services."</blockquote>
    <div class="quote-footer"><strong>— Sarah L.</strong> <span>· Gastonia, NC · Patio + Walkway</span></div>
    <div style="margin-top:32px"><a href="#" style="font-size:11px;letter-spacing:.14em;text-transform:uppercase;border-bottom:1px solid var(--stone-900);padding-bottom:4px;font-weight:600">See More Reviews →</a></div>
  </div>
</section>

<!-- SERVICE AREAS + MAP -->
<section id="work" class="areas">
  <div class="container areas-grid">
    <div>
      <div class="eyebrow">Service Areas</div>
      <h2>Where we pour.</h2>
      <p>Based in <strong style="color:var(--stone-900)">Gastonia, NC 28012</strong> — serving Gaston, Cleveland and York counties within about a 40-mile radius. If you're nearby, we're there.</p>
      <div class="pill-grid">
        <span class="pill">Gastonia, NC</span><span class="pill">Belmont, NC</span><span class="pill">Stanley, NC</span><span class="pill">Mount Holly, NC</span><span class="pill">Shelby, NC</span><span class="pill">Kings Mountain, NC</span><span class="pill">Lake Wylie, NC</span><span class="pill">Fort Mill, SC</span><span class="pill">Blacksburg, SC</span><span class="pill">Iron Station, NC</span><span class="pill">Glover, NC</span>
      </div>
      <p style="margin-top:20px;font-size:13px;color:var(--muted)">Don't see your town? Call — if we can get a truck there, we'll quote it.</p>
    </div>
    <div class="map-placeholder">
      <div>
        <b>Gastonia · Belmont · Shelby Corridor</b>
        <span style="font-size:13px;line-height:1.6">Interactive map embed goes here<br />(Google Business Profile + service area polygon for SEO)</span>
        <div style="margin-top:16px"><span class="pill" style="background:var(--stone-900);color:#fff;border-color:var(--stone-900)">View on Google Maps</span></div>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section id="contact" class="cta">
  <div class="container">
    <div class="eyebrow" style="justify-content:center">Start Your Project</div>
    <h2>Ready to make it <em>Flat?</em></h2>
    <p>Free on-site estimates. Straight pricing. Schedule Monday–Saturday, 7AM–9PM. Tell us about your driveway, patio, walk, or wall — we'll bring the form.</p>
    <div class="cta-actions">
      <a class="btn btn-dark" href="tel:7046748306">Call (704) 674-8306</a>
      <a class="btn btn-light" href="mailto:qualityconcrete28012@gmail.com">Email Us</a>
    </div>
    <p style="margin-top:20px;font-size:12px;letter-spacing:.08em;color:var(--muted)">qualityconcrete28012@gmail.com · Mon–Sat 7AM–9PM · Sun Closed · Gastonia, NC 28012</p>
  </div>
</section>

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <b>Flatwork</b>
        <span>and Foundations Co.</span>
        <span style="margin-top:8px;color:#555;letter-spacing:.08em;text-transform:none;font-size:11px">Quality Concrete Construction LLC of Gastonia<br />d/b/a Flatwork and Foundations Co.</span>
        <p>Premium concrete in Gastonia, NC since ~2004. Driveways, patios, sidewalks, retaining walls, paving, grading and small land clearing.</p>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li><a href="tel:7046748306">(704) 674-8306</a></li>
          <li><a href="mailto:qualityconcrete28012@gmail.com">qualityconcrete28012@gmail.com</a></li>
          <li>Gastonia, NC 28012</li>
          <li>Mon–Sat 7AM–9PM</li>
        </ul>
      </div>
      <div>
        <h4>Services</h4>
        <ul>
          <li><a href="#">Sidewalk Construction</a></li>
          <li><a href="#">Walkway Construction</a></li>
          <li><a href="#">Retaining Walls</a></li>
          <li><a href="#">Concrete Paving</a></li>
          <li><a href="#">Patio Construction</a></li>
          <li><a href="#">Grading & Land Clearing</a></li>
        </ul>
      </div>
      <div>
        <h4>Company</h4>
        <ul>
          <li><a href="#">About</a></li>
          <li><a href="#">Our Work / Gallery</a></li>
          <li><a href="#">Testimonials</a></li>
          <li><a href="#">Contact</a></li>
          <li>FB / IG: @FlatworkAndFoundations</li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2026 Flatwork and Foundations Co. All Rights Reserved. — A d/b/a of Quality Concrete Construction LLC of Gastonia, North Carolina.</span>
      <span>Built by Shelby Web Co. · Astro + SEO Ready</span>
    </div>
  </div>
</footer>

</Layout>
